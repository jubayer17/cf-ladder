# Core practice, contests and stats use the built-in Codeforces proxy.
# Optional: enable applause with an Upstash Redis REST database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
APPLAUSE_IP_LIMIT=30
APPLAUSE_IP_WINDOW_SEC=3600
# Optional: enable bug reports. Use a Gmail app password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_TARGET=
# Optional: donation options shown in the Support popup (header + footer). Any one enables it.
NEXT_PUBLIC_BKASH_NUMBER=
NEXT_PUBLIC_NAGAD_NUMBER=
NEXT_PUBLIC_PATREON_URL=
# One-time $5 coffee (a paid Patreon post)
NEXT_PUBLIC_PATREON_COFFEE_URL=
